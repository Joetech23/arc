# Copy to .env.local and fill in before deploying.

SITE_URL=https://arcmarshaldzine.com

# EmailJS — https://www.emailjs.com/
NEXT_PUBLIC_EMAILJS_SERVICE_ID=
NEXT_PUBLIC_EMAILJS_TEMPLATE_CONTACT_ID=
NEXT_PUBLIC_EMAILJS_TEMPLATE_QUOTE_ID=
NEXT_PUBLIC_EMAILJS_PUBLIC_KEY=

# Google Search Console — meta-tag verification token (the content="..." value)
NEXT_PUBLIC_GSC_VERIFICATION=
